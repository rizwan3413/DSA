//Kadans Algorithm
int maxSum(vector<int> &nums){
    int currSum = 0;
    int maxSum = INT_MIN;
    
    for(int val: nums){
        currSum += val;
        maxSum = max(currSum, maxSum);
        
        if( currSum < 0){
            currSum = 0;
        }
    }
    return maxSum;
}

//Single Element
int singleElement(vector<int> & nums){
    int unique_elem = 0;
    
    for(auto &val : nums){
        unique_elem = unique_elem ^ val;
    }
    return unique_elem;
}

//PairSum
vector<int> PairSum(vector<int> &nums, int target){
    int start = 0;
    int end = (int)nums.size() -1;
    
    while (start < end){
        int sum = (nums[start] + nums[end]);
        if(sum > target)
        {
            end--;
        }
        else if (sum < target){
            start++;
        }
        else {
            return {start, end};
        }
    }
    return {-1, -1};
}

